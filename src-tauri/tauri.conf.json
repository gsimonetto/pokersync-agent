{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radar PokerSync",
  "version": "0.1.0",
  "identifier": "com.pokersync.radar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Radar PokerSync",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "schemes": ["radar-pokersync"]
    }
  }
}
